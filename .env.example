# ── LLM Provider (for semantic gap auto-resolution) ──────────────────────────
# Options: "gemini" | "openai" | "none" (default — falls back to heuristic)
LLM_PROVIDER=none

# API key for your chosen provider
LLM_API_KEY=your_api_key_here

# Model to use (defaults shown below)
# For Gemini: gemini-2.0-flash
# For OpenAI: gpt-4o-mini
LLM_MODEL=gemini-2.0-flash

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=2

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
